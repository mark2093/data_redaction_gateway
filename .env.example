# ============================================================================
# PII/PCI Data Redaction Gateway - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED SECURITY SETTINGS
# ----------------------------------------------------------------------------

# API Keys for gateway access (comma-separated list)
# Generate secure keys with: openssl rand -base64 32
API_KEYS=your-api-key-1,your-api-key-2

# JWT Secret Key for authentication tokens
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=your-jwt-secret-key-here

# HMAC Secret for tokenization
# Generate with: openssl rand -base64 32
HMAC_SECRET_KEY=your-hmac-secret-key-here

# Encryption Key for Format-Preserving Encryption (FPE)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# ----------------------------------------------------------------------------
# JWT CONFIGURATION (Optional - defaults in config.yaml)
# ----------------------------------------------------------------------------

# JWT algorithm (default: HS256)
# JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 30)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days (default: 7)
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# LLM JUDGE CONFIGURATION (Required if llm_judge.enabled=true)
# ----------------------------------------------------------------------------

# LLM API Key for validation service
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/
LLM_API_KEY=your-llm-api-key-here

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION (Optional - defaults in config.yaml)
# ----------------------------------------------------------------------------

# Server host (default: 0.0.0.0)
# SERVER_HOST=0.0.0.0

# Server port (default: 8000)
# SERVER_PORT=8000

# Environment (development, staging, production)
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# TLS/SSL CONFIGURATION (Optional)
# ----------------------------------------------------------------------------

# Enable TLS/SSL (default: false)
# TLS_ENABLED=true

# TLS certificate file path (required if TLS_ENABLED=true)
# TLS_CERT_FILE=/path/to/cert.pem

# TLS key file path (required if TLS_ENABLED=true)
# TLS_KEY_FILE=/path/to/key.pem

# ----------------------------------------------------------------------------
# QUICK SETUP COMMANDS
# ----------------------------------------------------------------------------
#
# Generate all secrets at once (PowerShell):
#
# $apiKey1 = [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# $apiKey2 = [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# $jwtSecret = [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
# $hmacSecret = [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# $encryptionKey = [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
# Write-Host "API_KEYS=$apiKey1,$apiKey2"
# Write-Host "JWT_SECRET_KEY=$jwtSecret"
# Write-Host "HMAC_SECRET_KEY=$hmacSecret"
# Write-Host "ENCRYPTION_KEY=$encryptionKey"
#
# ----------------------------------------------------------------------------
# Generate all secrets at once (Bash/Linux/Mac):
#
# echo "API_KEYS=$(openssl rand -base64 32),$(openssl rand -base64 32)"
# echo "JWT_SECRET_KEY=$(openssl rand -base64 64)"
# echo "HMAC_SECRET_KEY=$(openssl rand -base64 32)"
# echo "ENCRYPTION_KEY=$(openssl rand -base64 32)"
#
# ----------------------------------------------------------------------------
# SECURITY BEST PRACTICES
# ----------------------------------------------------------------------------
#
# 1. NEVER commit .env file to version control
# 2. Use different secrets for each environment (dev/staging/prod)
# 3. Rotate secrets regularly (every 90 days minimum)
# 4. Store production secrets in secure vault (Azure Key Vault, AWS Secrets Manager, etc.)
# 5. Use minimum required permissions for service accounts
# 6. Enable TLS/SSL in production environments
# 7. Monitor audit logs for unauthorized access attempts
# 8. Use separate API keys per client/service for better tracking
#
# ----------------------------------------------------------------------------
# DEPLOYMENT-SPECIFIC NOTES
# ----------------------------------------------------------------------------
#
# Docker/Docker Compose:
#   - Mount .env file or use docker-compose environment section
#   - Or pass variables via -e flags: docker run -e API_KEYS=...
#
# Kubernetes:
#   - Use Secrets: kubectl create secret generic gateway-secrets --from-env-file=.env
#   - Reference in deployment: envFrom.secretRef
#
# Cloud Platforms (AWS/Azure/GCP):
#   - Use native secret managers (AWS Secrets Manager, Azure Key Vault, GCP Secret Manager)
#   - Configure auto-rotation policies
#   - Use IAM roles for service authentication
#
# ----------------------------------------------------------------------------
