# Environment Configuration for PII/PCI Data Redaction Gateway

# API Keys (comma-separated for multiple keys)
API_KEYS=dev-api-key-12345,test-api-key-67890

# HMAC Secret Key for Tokenization
# IMPORTANT: Change this in production!
HMAC_SECRET_KEY=default-hmac-key-change-in-production

# Encryption Key for Format-Preserving Encryption
# IMPORTANT: Change this in production!
ENCRYPTION_KEY=default-encryption-key-change-in-production

# TLS Configuration
TLS_ENABLED=false
MTLS_ENABLED=false

# Certificate paths (if TLS is enabled)
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem
# TLS_CA_PATH=/path/to/ca.pem

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# Policy Configuration
POLICY_PATH=input/redaction_rules.yaml
POLICY_RELOAD_INTERVAL=3600  # seconds

# Cache Configuration
CACHE_TTL=300  # seconds (5 minutes)
CACHE_SIZE=1000

# Logging
LOG_LEVEL=INFO

# Metrics
METRICS_ENABLED=true

# LLM Judge Configuration
# Get your OpenAI API key from: https://platform.openai.com/api-keys
LLM_API_KEY=sk-proj-your-openai-api-key-here
# Alternative providers: Set provider in config.yaml
# For Anthropic: Get key from https://console.anthropic.com/
# For local models: Use Ollama (no key needed)

